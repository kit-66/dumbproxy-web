# ============================================================
# DUMBPROXY WEB
# ============================================================


# ------------------------------------------------------------
# Срок действия общего доступа, минут.
#
# Все посетители получают один credential,
# пока этот срок не истёк.
#
# После истечения следующий запрос создаст новый.
# ------------------------------------------------------------

ACCESS_TTL_MINUTES=10


# ------------------------------------------------------------
# Имя пользователя proxy.
#
# Можно свободно изменить под свой проект.
# ------------------------------------------------------------

PROXY_USERNAME=Proxy_Username


# ------------------------------------------------------------
# Публичный адрес dumbproxy.
#
# Это адрес, который должен быть доступен
# конечному пользователю.
#
# НЕ указывайте здесь:
#
#   tempkey-dumbproxy
#
# если proxy должен использоваться
# с телефона/ПК пользователя через интернет.
#
# Пример:
#
# PROXY_HOST=proxy.example.com
# ------------------------------------------------------------

PROXY_HOST=proxy.example.com


# ------------------------------------------------------------
# Публичный порт dumbproxy.
# ------------------------------------------------------------

PROXY_PORT=8080


# ------------------------------------------------------------
# Схема подключения.
#
# Обычный dumbproxy:
#
#   http
#
# ------------------------------------------------------------

PROXY_SCHEME=http


# ------------------------------------------------------------
# HMAC SECRET
#
# Должен совпадать с секретом,
# используемым dumbproxy.
#
# Пример генерации:
#
# openssl rand -hex 32
#
# ------------------------------------------------------------

DUMBPROXY_HMAC_SECRET=change-me
