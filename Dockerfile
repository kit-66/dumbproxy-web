# ------------------------------------------------------------
# Минимальный Alpine-образ Python.
# ------------------------------------------------------------

FROM python:3.11-alpine


# Рабочая директория приложения.
WORKDIR /app


# ------------------------------------------------------------
# Устанавливаем только необходимые зависимости.
#
# Flask  -> HTTP/API
# qrcode -> генерация QR-кодов
# Pillow -> PNG backend для qrcode
#
# --no-cache-dir уменьшает размер image.
# ------------------------------------------------------------

RUN pip install --no-cache-dir \
    flask \
    "qrcode[pil]"


# ------------------------------------------------------------
# Копируем Python-приложение.
#
# index.html сюда НЕ копируем.
# Он будет подключён через volume.
# ------------------------------------------------------------

COPY app.py /app/app.py


# Создаём директорию для сайта.
RUN mkdir -p /app/site


# Документируем внутренний порт.
EXPOSE 3000


# Запускаем приложение.
CMD ["python", "app.py"]
